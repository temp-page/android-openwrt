# Droidspaces OpenWrt rootfs target: armsr/armv8 => aarch64_generic packages.
# Use legacy IPSet only. OpenClash otherwise sees nftset first and emits rules
# the Android kernel cannot accept.
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
# Select only the full variant. The SDK's default lightweight variant would
# otherwise be compiled first and does not contain legacy IPSet support.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
# CONFIG_PACKAGE_dnsmasq_full_nftset is not set
# Conntrack would add an OpenWrt kernel-module dependency. Droidspaces uses
# Android's host kernel, and OpenClash's legacy IPSet mode does not need it.
# CONFIG_PACKAGE_dnsmasq_full_conntrack is not set
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
